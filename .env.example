# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file with real credentials to version control

# Azure Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id-here
AZURE_RESOURCE_GROUP=your-resource-group
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-key-here

# Azure Logic App Configuration
LOGIC_APP_CALLBACK_URL=https://your-logic-app-endpoint

# Azure Sentinel / Log Analytics
LOG_ANALYTICS_WORKSPACE_ID=your-workspace-id
LOG_ANALYTICS_WORKSPACE_KEY=your-workspace-key

# Email Notification Configuration
NOTIFICATION_EMAIL=security-team@example.com
SENDER_EMAIL=azure-alerts@example.com

# Third-party Services (if applicable)
# Only add these if your specific incident response workflow requires them
# API_KEY=your-api-key-here
# SERVICE_URL=https://your-service.example.com

# Notes:
# - Use Azure Key Vault for production environments
# - Rotate credentials regularly
# - Use managed identities when possible
# - Follow principle of least privilege
